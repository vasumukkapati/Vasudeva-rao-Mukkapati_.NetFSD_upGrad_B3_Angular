@model List<WebApplication6.Models.Product>

<h2>Product List</h2>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Price</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Price</td>
                <td>
                    <a asp-controller="Product"
                           asp-action="Details"
                           asp-route-id="@item.Id">
                        View Details
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>